import QtQuick
import Quickshell
import Quickshell.Io
import qs.Ui

BarWidget {
  id: root
  moduleName: "dev.roflochinsky.beads"

  // These launchers are generated by the opt-in installer with explicit argv.
  // They are local plugin files, never shell strings supplied by the renderer.
  readonly property string countPath: localPath(Qt.resolvedUrl("count.sh"))
  readonly property string togglePath: localPath(Qt.resolvedUrl("toggle.sh"))
  property var state: ({ kind: "loading" })
  property string processOutput: ""
  property string processError: ""
  readonly property var readiness: state.kind === "ready" ? state.readiness : null
  readonly property color ink: root.bar ? root.bar.barForeground : "white"

  implicitWidth: button.implicitWidth
  implicitHeight: button.implicitHeight

  function localPath(url) {
    var value = String(url)
    return value.indexOf("file://") === 0 ? decodeURIComponent(value.slice(7)) : ""
  }

  function fail(message) {
    state = { kind: "error", message: String(message || "Unable to read Beads readiness") }
  }

  function acceptOutput(output) {
    try {
      var result = JSON.parse(output)
      if (!result || typeof result !== "object") throw new Error("Invalid Beads response")
      if (result.kind === "ready") {
        var value = result.readiness
        if (!value || typeof value.ready !== "number" || !isFinite(value.ready) || value.ready < 0 || Math.floor(value.ready) !== value.ready
            || typeof value.active !== "boolean" || typeof value.done !== "boolean" || typeof value.hasIssues !== "boolean"
            || typeof value.projectCount !== "number" || value.projectCount < 1 || Math.floor(value.projectCount) !== value.projectCount)
          throw new Error("Invalid Beads readiness")
      } else if (result.kind === "error") {
        if (typeof result.message !== "string") throw new Error("Invalid Beads error")
      } else if (result.kind !== "loading" && result.kind !== "unconfigured") {
        throw new Error("Invalid Beads response")
      }
      state = result
    } catch (error) {
      fail(error.message || error)
    }
  }

  function refresh() {
    if (statusProcess.running) return
    if (!countPath) { fail("Beads helper path is unavailable"); return }
    processOutput = ""
    processError = ""
    statusProcess.running = true
  }

  function tooltip() {
    if (state.kind === "error") return "Beads: " + state.message
    if (state.kind === "unconfigured") return "Beads: select a project"
    if (!readiness) return "Beads: loading selected projects"
    return "Beads: " + readiness.ready + " ready across " + readiness.projectCount
      + (readiness.projectCount === 1 ? " project" : " projects")
  }

  Process {
    id: statusProcess
    command: [root.countPath]
    stdout: StdioCollector { id: statusStdout; waitForEnd: true; onStreamFinished: root.processOutput = text }
    stderr: StdioCollector { id: statusStderr; waitForEnd: true; onStreamFinished: root.processError = text }
    onExited: function(exitCode) {
      var output = String(statusStdout.text || root.processOutput || "")
      var error = String(statusStderr.text || root.processError || "")
      if (exitCode === 0) root.acceptOutput(output)
      else root.fail(error || "Unable to run the Beads readiness helper")
    }
  }

  Timer {
    interval: 30000
    repeat: true
    running: true
    triggeredOnStart: true
    onTriggered: root.refresh()
  }

  WidgetButton {
    id: button
    anchors.fill: parent
    bar: root.bar
    text: "Beads"
    labelVisible: false
    fixedWidth: root.vertical ? root.barSize : marks.implicitWidth + 16
    fixedHeight: root.vertical ? marks.implicitHeight + 12 : root.barSize
    tooltipText: root.tooltip()
    onPressed: function(mouseButton) {
      if (mouseButton === Qt.LeftButton && root.togglePath)
        Quickshell.execDetached([root.togglePath])
      else if (mouseButton === Qt.MiddleButton) root.refresh()
    }

    Grid {
      id: marks
      anchors.centerIn: parent
      columns: root.vertical ? 1 : 4
      columnSpacing: 3
      rowSpacing: 1

      Repeater {
        model: 3
        delegate: Item {
          required property int index
          width: 8
          height: root.vertical ? 8 : 14
          opacity: root.readiness && root.readiness.hasIssues && (index === 0 ? root.readiness.done
            : index === 1 ? root.readiness.active : root.readiness.ready > 0) ? 1 : 0.35

          Rectangle {
            width: 7; height: 7; radius: 3.5
            anchors.centerIn: parent
            color: index === 0 ? root.ink : "transparent"
            border.color: root.ink
            border.width: 1
            Rectangle {
              visible: index === 1
              anchors.centerIn: parent
              width: 2; height: 2; radius: 1
              color: root.ink
            }
          }
        }
      }
      Text {
        visible: !root.vertical || root.state.kind === "error"
        text: root.readiness ? String(root.readiness.ready)
          : root.state.kind === "error" ? "!" : root.state.kind === "loading" ? "…" : "–"
        color: root.ink
        font.family: root.bar ? root.bar.fontFamily : "monospace"
        font.pixelSize: 11
        textFormat: Text.PlainText
      }
    }
  }
}
